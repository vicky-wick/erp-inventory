# Neon Postgres connection (pooled). Get it from https://console.neon.tech
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Set to "development" to allow exposing password-reset tokens in API responses
NODE_ENV=development

# Vite (frontend, dev only)
VITE_APP_NAME=EVOLV
