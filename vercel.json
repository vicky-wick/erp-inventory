{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "regions": ["bom1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler" },
    {
      "source": "/((?!api/|assets/|manifest\\.webmanifest|sw\\.js|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  }
}
